DATABASE_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Sentry. Leave blank to disable error reporting. See README, "Error reporting".
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# PostHog. Leave blank to disable event tracking. The key is a public project key.
# Events: sign_up, quiz_finished, review_saved, direction_viewed.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Comma-separated founder emails that can open /founders. Leave blank to hide the queue.
FOUNDER_EMAILS=
# Keyed hash for email addresses Swervly matches but doesn't store (advisor rosters, invites).
# At least 32 random characters, e.g. `openssl rand -hex 32`. Changing it invalidates stored hashes.
EMAIL_HASH_SECRET=
